# Copiar a .env.local y completar con los datos del proyecto de Supabase.
# Panel: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secreto compartido con la Custom Function de Retell.
# Lo manda como header `x-agent-secret` en /api/agent/catalog.
# Generar uno largo y aleatorio; sin esto el endpoint no atiende.
AGENT_API_SECRET=
